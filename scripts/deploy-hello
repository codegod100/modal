#!/usr/bin/env jolt
;; Deploy examples/hello to a fresh Modal container.
;;
;;   scripts/deploy-hello                    build + run once, print the output
;;   scripts/deploy-hello --who "my laptop"  pass a greeting through
;;   scripts/deploy-hello --deploy           publish the app instead of running it
;;   scripts/deploy-hello --rebuild-base     refresh the arch-nix image first
;;
;; The container is built on the arch-nix image that arch_nix.py publishes --
;; nix, substituters and trusted keys already configured there. This script
;; reconfigures none of that; it only checks the pieces are in place, then
;; hands the work to `modal`.

(require '[babashka.process :as p]
         '[clojure.string :as str])

;; The worktree root, found from this script rather than the caller's cwd.
(def repo
  (-> *file* java.io.File. .getAbsoluteFile .getParentFile .getParentFile .getPath))

(def base-app  (str repo "/arch_nix.py"))
(def hello-app (str repo "/examples/hello/modal_app.py"))

(defn- die [& msg]
  (binding [*out* *err*]
    (println (str/join " " (cons "deploy-hello:" msg))))
  (System/exit 1))

(defn- run!
  "Run argv with its output on our own stdout/stderr, from the repo root."
  [argv]
  (println (str "$ " (str/join " " argv)))
  (let [{:keys [exit]} (apply p/shell {:dir repo :continue true} argv)]
    (when-not (zero? exit)
      (die (first argv) "exited" exit))))

(defn- have? [cmd]
  (zero? (:exit (p/shell {:out :string :err :string :continue true}
                         "sh" "-c" (str "command -v " cmd)))))

(def help
  (str "usage: scripts/deploy-hello [--who TEXT] [--deploy] [--rebuild-base]\n"
       "\n"
       "  --who TEXT       greeting the app reports (default: a fresh Modal container)\n"
       "  --deploy         `modal deploy` the app instead of running it once\n"
       "  --rebuild-base   run arch_nix.py first, republishing the arch-nix image\n"))

(defn- parse-args [args]
  (loop [[a & more] args
         opts {:who "a fresh Modal container"}]
    (cond
      (nil? a)               opts
      (#{"-h" "--help"} a)   (assoc opts :help true)
      (= a "--deploy")       (recur more (assoc opts :deploy true))
      (= a "--rebuild-base") (recur more (assoc opts :rebuild-base true))
      (= a "--who")          (if-let [v (first more)]
                               (recur (rest more) (assoc opts :who v))
                               (die "--who needs a value"))
      :else                  (die "unknown argument" (pr-str a) "-- try --help"))))

(defn -main [& args]
  (let [{:keys [who deploy rebuild-base] :as opts} (parse-args args)]
    (when (:help opts)
      (print help)
      (System/exit 0))
    (when-not (.exists (java.io.File. ^String hello-app))
      (die "cannot find" hello-app))
    (when-not (have? "modal")
      (die "modal is not on PATH -- pip install modal && modal setup"))

    ;; The arch image carries the whole nix configuration, so it has to exist
    ;; before anything can be built on top of it.
    (when rebuild-base
      (run! ["modal" "run" base-app]))

    (if deploy
      (run! ["modal" "deploy" hello-app])
      (run! ["modal" "run" hello-app "--who" who]))

    (println (if deploy
               "deployed -- the app is now callable from the Modal UI or a client"
               "done"))))

(apply -main *command-line-args*)
